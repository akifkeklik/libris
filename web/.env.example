# ─────────────────────────────────────────────────────────────
# Libris Web Application — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit real credentials to version control.
# ─────────────────────────────────────────────────────────────

# Supabase Client Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend Service Configuration (Server-to-Server API)
BACKEND_URL=http://localhost:5000
LIBRIS_API_KEY=your-backend-api-key-here

# Error tracking (optional). Off unless set; the browser only downloads the Sentry SDK when
# NEXT_PUBLIC_SENTRY_DSN is set. Events are scrubbed of user data (src/lib/sentryScrub.ts).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Show the reminder settings once e-mail or push delivery is set up (see PHASE_3_REPORT.md).
NEXT_PUBLIC_REMINDERS_ENABLED=false
